{
  "name": "clips-poster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @clips-poster/web",
    "dev:api": "npm run dev --workspace @clips-poster/api",
    "dev:worker": "npm run dev --workspace @clips-poster/worker",
    "collect:kick": "npm run collect:kick --workspace @clips-poster/worker --",
    "collect:twitch": "npm run collect:twitch --workspace @clips-poster/worker --",
    "score:clips": "npm run score:clips --workspace @clips-poster/worker",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:generate": "npm run db:generate --workspace @clips-poster/database",
    "db:migrate": "npm run db:migrate --workspace @clips-poster/database",
    "db:deploy": "npm run db:deploy --workspace @clips-poster/database"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
